# Copy this file to .env and fill in the real values.
# .env is never committed.

APP_NAME="Our Coffee Shop"
APP_ENV=local
APP_DEBUG=true

# Where each site is reachable. Used for links between them.
CUSTOMER_URL=http://localhost/ourcoffee
ADMIN_URL=http://localhost/ourcoffee-admin

# Database. These are the XAMPP defaults; root has no password by default,
# which is fine locally but must be changed before the system goes live.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=our_coffee_shop
DB_USER=root
DB_PASS=

# Semaphore SMS.
# Get the key from https://semaphore.co dashboard, Account, API Keys.
SEMAPHORE_API_KEY=

# Leave SMS_DRY_RUN=true while building and rehearsing. Messages are written
# to storage/logs/sms.log and recorded in the sms_log table, but no credit is
# spent. Set it to false only for the live demo and real use.
SMS_DRY_RUN=true

# Security timeouts, in seconds
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
